# medialyte.de – Apache-Konfiguration für IONOS Webhosting

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer HTTPS und ohne www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://medialyte.de%{REQUEST_URI} [L,R=301,NE]

  # Alte WordPress-Adressen auf die neuen Seiten umleiten
  RewriteRule ^datenschutzerklaerung/?$ /datenschutz/ [L,R=301]
  RewriteRule ^beratung/?$ /termin/ [L,R=301]
  RewriteRule ^(kostenlose-erstberatung|kostenfreie-beratung|erstberatung)/?$ /termin/ [L,R=301]
  RewriteRule ^(dashboard|home|startseite)/?$ / [L,R=301]
  RewriteRule ^(faq|haeufige-fragen)$ /faq/ [L,R=301]
  RewriteRule ^(blog|wissen)/?$ /ratgeber/ [L,R=301]
  RewriteRule ^(webdesign|webdesign-agentur-hamburg|webdesign-agentur)/?$ /webdesign-hamburg/ [L,R=301]
  RewriteRule ^(seo|suchmaschinenoptimierung)/?$ /leistungen/seo/ [L,R=301]
  RewriteRule ^(google-ads|sea)/?$ /leistungen/google-ads/ [L,R=301]
  RewriteRule ^(relaunch|website-relaunch)/?$ /leistungen/website-relaunch/ [L,R=301]
  RewriteRule ^(onlineshop|online-shop|shop)/?$ /leistungen/online-shop/ [L,R=301]
  RewriteRule ^(social-media|social-media-marketing)/?$ /leistungen/social-media-marketing/ [L,R=301]
  RewriteRule ^(crm|kundenmanagement)/?$ /leistungen/kundenmanagement-system/ [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|feed)(/.*)?$ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(css|js|webp|png|jpg|svg|woff2|mp4|webm|vtt)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType text/vtt .vtt
</IfModule>
