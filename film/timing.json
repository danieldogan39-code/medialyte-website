 "sentences": [
  {
   "s": 0.9,
   "e": 3.4,
   "t": "Jemand sucht genau das, was Sie anbieten."
  },
  {
   "s": 3.92,
   "e": 7.62,
   "t": "Er findet ihre Website und ist nach wenigen Sekunden wieder weg."
  },
  {
   "s": 8.15,
   "e": 12.88,
   "t": "Veraltet, auf dem Handy kaum zu bedienen, die Öffnungszeiten vom letzten Jahr."
  },
  {
   "s": 13.48,
   "e": 18.4,
   "t": "Und die Anfragen, die trotzdem kommen, verteilen sich auf Telefon, E -Mail und WhatsApp."
  },
  {
   "s": 18.88,
   "e": 20.34,
   "t": "Und gehen im Alltag unter."
  },
  {
   "s": 22.04,
   "e": 23.79,
   "t": "Genau hier setzen wir an."
  },
  {
   "s": 24.33,
   "e": 27.13,
   "t": "Am Anfang steht ein kostenfreies Erstgespräch."
  },
  {
   "s": 27.59,
   "e": 31.04,
   "t": "Innerhalb von 48 Stunden haben Sie Ihr Angebot."
  },
  {
   "s": 31.04,
   "e": 38.0,
   "t": "Dann lernen wir Ihre Kunden kennen, gestalten Ihre neue Website, bauen und testen sie, bis sie live geht."
  },
  {
   "s": 38.54,
   "e": 45.54,
   "t": "Dahinter entsteht auf Wunsch Ihr eigenes System, indem jede Anfrage, jeder Termin und jeder Auftrag landet."
  },
  {
   "s": 46.87,
   "e": 49.09,
   "t": "Das alles bekommen Sie aus einer Hand."
  },
  {
   "s": 49.53,
   "e": 56.21,
   "t": "Website, System, Pflege und Werbung, aufeinander abgestimmt, mit einem festen Ansprechpartner."
  },
  {
   "s": 56.67,
   "e": 59.97,
   "t": "Aus über 200 Kampagnen wissen wir, was wirkt."
  },
  {
   "s": 59.91,
   "e": 65.61,
   "t": "Bei Rechnungsradar kamen mit der neuen Website 230 % mehr Anfragen."
  },
  {
   "s": 67.01,
   "e": 68.34,
   "t": "Und wenn sich etwas ändert?"
  },
  {
   "s": 68.82,
   "e": 72.38,
   "t": "Neue Öffnungszeiten, ein neues Angebot, frische Fotos."
  },
  {
   "s": 72.76,
   "e": 75.8,
   "t": "Schreiben Sie es einfach unserem KI -Agenten per WhatsApp."
  },
  {
   "s": 76.28,
   "e": 77.52,
   "t": "Er pflegt es für Sie ein."
  },
  {
   "s": 78.0,
   "e": 81.1,
   "t": "Bei umfangreichen Systemen geht das genauso im Dashboard."
  },
  {
   "s": 81.62,
   "e": 85.0,
   "t": "Und wenn es mehr braucht, ist unser Team persönlich für Sie da."
  },
  {
   "s": 86.22,
   "e": 89.38,
   "t": "Medialeit, damit aus Besuchern Kunden werden."
  },
  {
   "s": 89.85,
   "e": 93.21,
   "t": "Buchen Sie jetzt Ihr kostenfreies Erstgespräch."
  }
