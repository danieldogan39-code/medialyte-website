 "sentences": [
  {
   "s": 0.8,
   "e": 2.855,
   "t": "Jemand sucht genau das, was Sie anbieten."
  },
  {
   "s": 3.09,
   "e": 6.39,
   "t": "Er findet Ihre Website und ist nach wenigen Sekunden wieder weg."
  },
  {
   "s": 6.84,
   "e": 11.245,
   "t": "Veraltet, auf dem Handy kaum zu bedienen, die Öffnungszeiten vom letzten Jahr."
  },
  {
   "s": 11.835,
   "e": 18.39,
   "t": "Und die Anfragen, die trotzdem kommen, verteilen sich auf Telefon, E-Mail und WhatsApp und gehen im Alltag unter."
  },
  {
   "s": 19.27,
   "e": 20.385,
   "t": "Genau hier setzen wir an."
  },
  {
   "s": 21.265,
   "e": 23.57,
   "t": "Am Anfang steht ein kostenfreies Erstgespräch."
  },
  {
   "s": 23.775,
   "e": 26.4,
   "t": "Innerhalb von 48 Stunden haben Sie Ihr Angebot."
  },
  {
   "s": 26.98,
   "e": 32.2,
   "t": "Dann lernen wir Ihre Kunden kennen, gestalten Ihre neue Website, bauen und testen sie, bis sie live geht."
  },
  {
   "s": 32.725,
   "e": 39.69,
   "t": "Dahinter entsteht auf Wunsch Ihr eigenes System, in dem jede Anfrage, jeder Termin und jeder Auftrag landet."
  },
  {
   "s": 40.63,
   "e": 48.32,
   "t": "Das alles bekommen Sie aus einer Hand: Website, System, Pflege und Werbung, aufeinander abgestimmt, mit einem festen Ansprechpartner."
  },
  {
   "s": 48.9,
   "e": 51.56,
   "t": "Aus über 200 Kampagnen wissen wir, was wirkt."
  },
  {
   "s": 51.925,
   "e": 56.99,
   "t": "Bei RechnungsRadar kamen mit der neuen Website 230 Prozent mehr Anfragen."
  },
  {
   "s": 57.87,
   "e": 59.09,
   "t": "Und wenn sich etwas ändert?"
  },
  {
   "s": 59.46,
   "e": 66.82,
   "t": "Neue Öffnungszeiten, ein neues Angebot, frische Fotos: Schreiben Sie es einfach unserem KI-Agenten per WhatsApp."
  },
  {
   "s": 67.25,
   "e": 68.37,
   "t": "Er pflegt es für Sie ein."
  },
  {
   "s": 69.01,
   "e": 72.12,
   "t": "Bei umfangreichen Systemen geht das genauso im Dashboard."
  },
  {
   "s": 72.57,
   "e": 75.38,
   "t": "Und wenn es mehr braucht, ist unser Team persönlich für Sie da."
  },
  {
   "s": 76.225,
   "e": 76.92,
   "t": "Medialyte."
  },
  {
   "s": 77.37,
   "e": 79.29,
   "t": "Damit aus Besuchern Kunden werden."
  },
  {
   "s": 79.69,
   "e": 82.486,
   "t": "Buchen Sie jetzt Ihr kostenfreies Erstgespräch."
  }
